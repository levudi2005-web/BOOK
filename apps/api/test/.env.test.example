# =====================================================================
# BOOKFORFREEDOM - TEST ENVIRONMENT (copy to apps/api/test/.env.test)
# ---------------------------------------------------------------------
# Chỉ dùng cho stack `docker-compose.test.yml` (MariaDB :3308, Meili :7701).
# TUYỆT ĐỐI không trỏ vào production. Mọi giá trị dưới đây là test-only.
# =====================================================================
NODE_ENV=test
APP_ENV=test

BOOKUSER_DB_HOST=127.0.0.1
BOOKUSER_DB_PORT=3308
BOOKUSER_DB_NAME=bookuser
BOOKUSER_DB_USER=app_bookuser
BOOKUSER_DB_PASSWORD=test-bookuser-password

BOOKADMIN_DB_HOST=127.0.0.1
BOOKADMIN_DB_PORT=3308
BOOKADMIN_DB_NAME=bookadmin
BOOKADMIN_DB_USER=app_bookadmin
BOOKADMIN_DB_PASSWORD=test-bookadmin-password

GATEWAY_HMAC_SECRET=test-gateway-hmac-secret-not-for-production
TOKEN_HMAC_SECRET=test-token-hmac-secret-not-for-production
RECOVERY_KEY_HMAC_SECRET=test-recovery-hmac-secret-not-for-production
SESSION_SECRET=test-session-secret-not-for-production

MEILI_HOST=http://127.0.0.1:7701
MEILI_MASTER_KEY=test-meili-master-key

CORS_ORIGINS=http://127.0.0.1:3100

# Email: memory adapter ghi vào outbox (KHÔNG gửi thật) — chỉ dùng cho test.
MAIL_TRANSPORT=memory
APP_PUBLIC_URL=http://127.0.0.1:3100
