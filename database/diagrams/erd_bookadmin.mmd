%% ERD schema bookadmin - BOOKFORFREEDOM (MariaDB 10.11)
%% Sinh tu dong: 2026-11-20 18:22:54
erDiagram
  admin_accounts["admin_accounts<br/>Tài khoản Super Admin/Admin; tách biệt hoàn toàn với users của bookuser"] {
    bigint admin_id PK
    char admin_uuid UK
    varchar username UK
    varchar email UK
    enum status
    datetime created_at
  }
  admin_account_roles["admin_account_roles<br/>Bảng liên kết N-N giữa admin_accounts và admin_roles"] {
    bigint admin_id PK
    bigint role_id PK
    bigint assigned_by_admin_id FK
  }
  admin_announcements["admin_announcements<br/>Thông báo do admin phát hành; view v_public_announcements lọc theo đối tượng và thời gian"] {
    bigint announcement_id PK
    char announcement_uuid UK
    enum status
    bigint created_by_admin_id FK
    bigint published_by_admin_id FK
    datetime created_at
  }
  admin_audit_logs["admin_audit_logs<br/>Audit log append-only; trigger chặn UPDATE/DELETE, ứng dụng chỉ được INSERT/SELECT"] {
    bigint audit_id PK
    char audit_uuid UK
    bigint admin_id FK
    enum status
    datetime created_at
  }
  admin_login_attempts["admin_login_attempts<br/>Nhật ký đăng nhập admin (append-only), phục vụ phát hiện bất thường"] {
    bigint attempt_id PK
    bigint admin_id FK
  }
  admin_mfa_methods["admin_mfa_methods<br/>Phương thức MFA của admin; secret/khóa luôn được mã hóa, không lưu plaintext"] {
    bigint mfa_id PK
    bigint admin_id FK
    datetime created_at
  }
  admin_notifications["admin_notifications<br/>Thông báo trong ứng dụng quản trị; đánh dấu đã đọc kèm thời điểm"] {
    bigint notification_id PK
    char notification_uuid UK
    bigint recipient_admin_id FK
    datetime created_at
  }
  admin_password_reset_tokens["admin_password_reset_tokens<br/>Token đặt lại mật khẩu admin, chỉ lưu hash SHA-256"] {
    bigint token_id PK
    bigint admin_id FK
    binary token_hash UK
    datetime created_at
  }
  admin_permissions["admin_permissions<br/>Danh mục quyền chi tiết theo resource và action"] {
    bigint permission_id PK
    varchar code UK
    datetime created_at
  }
  admin_profiles["admin_profiles<br/>Hồ sơ nội bộ của tài khoản quản trị, 1-1 với admin_accounts"] {
    bigint profile_id PK
    bigint admin_id FK
    datetime created_at
  }
  admin_roles["admin_roles<br/>Vai trò RBAC: Super Admin, Administrator, Content Manager, Moderator, Analyst"] {
    bigint role_id PK
    varchar code UK
    varchar name UK
    datetime created_at
  }
  admin_role_permissions["admin_role_permissions<br/>Bảng liên kết N-N giữa admin_roles và admin_permissions"] {
    bigint role_id PK
    bigint permission_id PK
    bigint granted_by_admin_id FK
  }
  admin_sessions["admin_sessions<br/>Phiên đăng nhập khu vực quản trị, yêu cầu MFA trước khi cấp quyền"] {
    bigint session_id PK
    bigint admin_id FK
    binary session_token_hash UK
    datetime created_at
  }
  admin_user_notes["admin_user_notes<br/>Ghi chú nội bộ về người dùng; user_id là tham chiếu logic sang bookuser"] {
    bigint note_id PK
    bigint author_admin_id FK
    datetime created_at
  }
  book_rights_reviews["book_rights_reviews<br/>Xét duyệt nguồn gốc/giấy phép sách; book_id, rights_id là tham chiếu logic sang bookuser"] {
    bigint review_id PK
    char review_uuid UK
    enum status
    bigint reviewer_admin_id FK
    bigint open_book_id UK
    datetime created_at
  }
  content_reports["content_reports<br/>Báo cáo nội dung vi phạm; các ID bookuser là tham chiếu logic, kiểm tra ở service"] {
    bigint report_id PK
    char report_uuid UK
    bigint source_user_report_id UK
    bigint reason_id FK
    enum status
    bigint assigned_admin_id FK
    datetime created_at
  }
  feature_flags["feature_flags<br/>Cờ tính năng theo môi trường, hỗ trợ rollout theo phần trăm và quy tắc"] {
    bigint flag_id PK
    bigint updated_by_admin_id FK
    datetime created_at
  }
  integration_inbox["integration_inbox<br/>Inbox idempotent của bookadmin: nhận sự kiện từ bookuser, chống trùng theo event_id"] {
    bigint inbox_id PK
    char event_id UK
    enum status
    datetime created_at
  }
  integration_outbox["integration_outbox<br/>Transactional outbox của bookadmin: ghi cùng transaction nghiệp vụ, worker phát sang bookuser"] {
    bigint outbox_id PK
    char event_id UK
    enum status
    datetime created_at
  }
  maintenance_windows["maintenance_windows<br/>Lịch bảo trì hệ thống, dùng để bật chế độ chỉ đọc và thông báo"] {
    bigint window_id PK
    char window_uuid UK
    enum status
    bigint created_by_admin_id FK
    datetime created_at
  }
  moderation_actions["moderation_actions<br/>Nhật ký hành động kiểm duyệt, lưu trạng thái trước/sau để truy vết"] {
    bigint action_id PK
    char action_uuid UK
    bigint case_id FK
    bigint admin_id FK
    datetime created_at
  }
  moderation_cases["moderation_cases<br/>Hồ sơ kiểm duyệt nội dung; kết nối báo cáo, phân công và quyết định xử lý"] {
    bigint case_id PK
    char case_uuid UK
    varchar case_number UK
    bigint report_id FK
    enum status
    bigint assigned_admin_id FK
    bigint opened_by_admin_id FK
    datetime created_at
  }
  report_reasons["report_reasons<br/>Danh mục lý do báo cáo nội dung, dùng chung cho API và UI"] {
    bigint reason_id PK
    varchar code UK
    datetime created_at
  }
  security_events["security_events<br/>Sự kiện bảo mật phục vụ phát hiện bất thường; user_id là tham chiếu logic"] {
    bigint event_id PK
    char event_uuid UK
    bigint admin_id FK
    datetime created_at
  }
  system_metrics_daily["system_metrics_daily<br/>Chỉ số tổng hợp theo ngày; dimension_key bảo đảm tính duy nhất khi dimension là JSON"] {
    bigint metric_id PK
    datetime created_at
  }
  system_settings["system_settings<br/>Cấu hình hệ thống có kiểu dữ liệu và phạm vi công khai rõ ràng"] {
    bigint setting_id PK
    varchar setting_key UK
    bigint updated_by_admin_id FK
    datetime created_at
  }
  user_restrictions["user_restrictions<br/>Hạn chế/khóa/đình chỉ người dùng; user_id tham chiếu logic sang bookuser"] {
    bigint restriction_id PK
    char restriction_uuid UK
    enum status
    bigint issued_by_admin_id FK
    bigint lifted_by_admin_id FK
    bigint active_lock_key UK
    datetime created_at
  }
  user_verification_reviews["user_verification_reviews<br/>Hồ sơ xác minh người dùng (email/CMND/tác giả/NXB); user_id tham chiếu logic"] {
    bigint review_id PK
    char review_uuid UK
    enum status
    bigint reviewer_admin_id FK
    datetime created_at
  }
