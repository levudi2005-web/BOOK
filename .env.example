NODE_ENV=development

POSTGRES_DB=bookforfreedom
POSTGRES_USER=bff_dev
POSTGRES_PASSWORD=replace-this-local-dev-password
DATABASE_URL=postgresql://bff_dev:replace-this-local-dev-password@localhost:5432/bookforfreedom

REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=bff_minio
MINIO_ROOT_PASSWORD=replace-this-minio-password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false

MEILI_MASTER_KEY=replace-this-meilisearch-development-key
MEILI_HOST=http://localhost:7700

SESSION_SECRET=replace-this-session-secret-before-use

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=placeholder
SMTP_PASSWORD=replace-this-smtp-password
SMTP_FROM=BOOKFORFREEDOM <noreply@example.invalid>
