# Mẫu môi trường cho phát triển local.
# Sao chép thành .env, thay toàn bộ secret, rồi chạy: chmod 600 .env
# Không commit .env. Trên VPS dùng APP_URL/API_PUBLIC_URL là domain HTTPS thật.
NODE_ENV=development
APP_ENV=development
APP_NAME=BOOKFORFREEDOM
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
TZ=UTC
LOG_LEVEL=debug

# MariaDB chạy trong Docker (cổng host 3307 để không đụng MariaDB hệ thống 3306)
MARIADB_ROOT_PASSWORD=replace-this-mariadb-root-password
MARIADB_PORT=3307

BOOKUSER_DB_HOST=localhost
BOOKUSER_DB_PORT=3307
BOOKUSER_DB_NAME=bookuser
BOOKUSER_DB_USER=app_bookuser
BOOKUSER_DB_PASSWORD=replace-this-bookuser-password

BOOKADMIN_DB_HOST=localhost
BOOKADMIN_DB_PORT=3307
BOOKADMIN_DB_NAME=bookadmin
BOOKADMIN_DB_USER=app_bookadmin
BOOKADMIN_DB_PASSWORD=replace-this-bookadmin-password

# URL tiện dụng; mật khẩu có ký tự đặc biệt phải được URL-encode.
DATABASE_URL=mysql://app_bookuser:replace-this-bookuser-password@localhost:3307/bookuser
BOOKADMIN_DATABASE_URL=mysql://app_bookadmin:replace-this-bookadmin-password@localhost:3307/bookadmin

# Redis có mật khẩu; REDIS_URL phải khớp REDIS_PASSWORD.
REDIS_PASSWORD=replace-this-redis-password
REDIS_URL=redis://:replace-this-redis-password@localhost:6379

MINIO_ROOT_USER=bff_minio
MINIO_ROOT_PASSWORD=replace-this-minio-password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false

MEILI_ENV=production
MEILI_NO_ANALYTICS=true
MEILI_MASTER_KEY=replace-this-meilisearch-development-key
MEILI_HOST=http://localhost:7700

SESSION_SECRET=replace-this-session-secret-before-use
SESSION_COOKIE_NAME=bff_session
# Secret HMAC cho Security Token (KHÔNG commit giá trị thật).
TOKEN_HMAC_SECRET=replace-this-token-hmac-secret-before-use
# Secret HMAC riêng cho Security Recovery Key (KHÔNG commit giá trị thật).
RECOVERY_KEY_HMAC_SECRET=replace-this-recovery-key-hmac-secret-before-use
# Secret HMAC cho service-to-service (Cloudflare Workers -> VPS Data Gateway).
GATEWAY_HMAC_SECRET=replace-this-gateway-hmac-secret-before-use
# Service accounts tách GRANT (User Auth / Admin Auth / Admin Management).
SVC_USER_AUTH_USER=svc_user_auth
SVC_USER_AUTH_PASSWORD=replace-this-svc-user-auth-password
SVC_ADMIN_AUTH_USER=svc_admin_auth
SVC_ADMIN_AUTH_PASSWORD=replace-this-svc-admin-auth-password
SVC_ADMIN_MGMT_USER=svc_admin_mgmt
SVC_ADMIN_MGMT_PASSWORD=replace-this-svc-admin-mgmt-password
# Local HTTP có thể đặt false; production bắt buộc true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=placeholder
SMTP_PASSWORD=replace-this-smtp-password
SMTP_FROM="BOOKFORFREEDOM <noreply@example.invalid>"

# CORS: danh sach origin frontend duoc phep (phan cach bang dau phay)
CORS_ORIGINS=http://localhost:3000
